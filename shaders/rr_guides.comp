#version 460
// DLSS Ray Reconstruction guide buffers, decoded from the G-buffer at render
// resolution (see rr_guides.cpp):
//   o_albedo       diffuse reflectance (linear)
//   o_spec_albedo  specular reflectance = EnvBRDFApprox2(F0, alpha, NoV)
//   o_normal_rough world-space shading normal xyz + linear roughness w
// The material decode mirrors deferred_lighting.frag (gbuffer1.b roughness
// except terrain, gbuffer1.a foliage / metal flags).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_gbuffer0;
layout(set = 0, binding = 1) uniform sampler2D u_gbuffer1;
layout(set = 0, binding = 2) uniform sampler2D u_depth;
layout(set = 0, binding = 3, rgba8)   uniform writeonly image2D o_albedo;
layout(set = 0, binding = 4, rgba8)   uniform writeonly image2D o_spec_albedo;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D o_normal_rough;
layout(set = 0, binding = 6) uniform sampler2D u_scene_color;   // the lit HDR frame RR will resolve

layout(push_constant) uniform PC {
    mat4 inv_vp;      // jittered clip -> world (matches the depth buffer)
    vec4 cam_pos;     // xyz
} pc;

vec3 octa_decode(vec2 e) {
    e = e * 2.0 - 1.0;
    vec3 n = vec3(e.x, e.y, 1.0 - abs(e.x) - abs(e.y));
    float t = max(-n.z, 0.0);
    n.x += (n.x > 0.0) ? -t : t;
    n.y += (n.y > 0.0) ? -t : t;
    return normalize(n);
}

// Streamline DLSS-RR guide, section 4.2.1 [Ray Tracing Gems, ch. 32].
vec3 env_brdf_approx2(vec3 spec_color, float alpha, float NoV) {
    NoV = abs(NoV);
    vec4 X = vec4(1.0, NoV, NoV * NoV, NoV * NoV * NoV);
    vec4 Y = vec4(1.0, alpha, alpha * alpha, alpha * alpha * alpha);
    // HLSL float2x2 / float3x3 constructors are row-major; mul(M, v) = M * v.
    mat2 M1 = transpose(mat2(0.99044, -1.28514, 1.29678, -0.755907));
    mat3 M2 = transpose(mat3(1.0, 2.92338, 59.4188, 20.3225, -27.0302, 222.592, 121.563, 626.13, 316.627));
    mat2 M3 = transpose(mat2(0.0365463, 3.32707, 9.0632, -9.04756));
    mat3 M4 = transpose(mat3(1.0, 3.59685, -1.36772, 9.04401, -16.3174, 9.22949, 5.56589, 19.7886, -20.2123));
    float bias  = dot(M1 * X.xy, Y.xy) / dot(M2 * X.xyw, Y.xyw);
    float scale = dot(M3 * X.xy, Y.xy) / dot(M4 * X.xzw, Y.xyw);
    bias *= clamp(spec_color.g * 50.0, 0.0, 1.0);   // reflectance 0 -> no specular
    return spec_color * max(0.0, scale) + max(0.0, bias);
}

// Guide for pixels whose colour is already final (sky, particles, pre-shaded
// forward materials): use the colour itself, normalised into 0..1, as the
// albedo. RR denoises colour / albedo, which is then flat, so the texture
// detail of these pixels is carried by the guide instead of being smoothed
// away as if it were lighting noise.
vec3 color_as_albedo(ivec2 px) {
    vec3 c = max(texelFetch(u_scene_color, px, 0).rgb, vec3(0.0));
    float m = max(max(c.r, c.g), max(c.b, 1.0));
    return max(c / m, vec3(0.02));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(o_albedo);
    if (px.x >= size.x || px.y >= size.y) return;

    vec4  g0 = texelFetch(u_gbuffer0, px, 0);
    vec4  g1 = texelFetch(u_gbuffer1, px, 0);
    float z  = texelFetch(u_depth, px, 0).r;
    int   material_id = int(g0.a * 255.0 + 0.5);
    bool  has_gbuffer = dot(g0.rgb, vec3(1.0)) >= 1e-4;

    // Sky and pixels drawn without G-buffer outputs (particles, viewmodel
    // overlays): no surface to guide with - colour as albedo (see above),
    // zero normal marks "no surface".
    if (z >= 0.99999 || !has_gbuffer) {
        imageStore(o_albedo, px, vec4(color_as_albedo(px), 0.0));
        imageStore(o_spec_albedo, px, vec4(0.0));
        imageStore(o_normal_rough, px, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec3 N = octa_decode(g1.xy);

    // Pre-shaded forward materials (>= 5: grass, water, raymarched terrain,
    // emissive) store their LIT colour in gbuffer0. Their shading is not
    // noisy ray-traced light; treat them as fully rough diffuse so RR does
    // not hallucinate reflections, with their colour as the albedo guide.
    if (material_id >= 5 || material_id == 0) {
        imageStore(o_albedo, px, vec4(color_as_albedo(px), 0.0));
        imageStore(o_spec_albedo, px, vec4(0.0));
        imageStore(o_normal_rough, px, vec4(N, 1.0));
        return;
    }

    bool  foliage   = g1.a > 0.83;
    float metallic  = (!foliage && g1.a > 0.5) ? 1.0 : 0.0;
    float roughness = (material_id == 3)
        ? mix(0.92, 0.48, smoothstep(0.45, 0.75, dot(g0.rgb, vec3(0.333))))
        : clamp(g1.b, 0.05, 1.0);

    vec2 uv  = (vec2(px) + 0.5) / vec2(size);
    vec4 wp4 = pc.inv_vp * vec4(uv * 2.0 - 1.0, z, 1.0);
    vec3 V   = normalize(pc.cam_pos.xyz - wp4.xyz / wp4.w);

    vec3 albedo = g0.rgb;
    vec3 F0     = mix(vec3(0.04), albedo, metallic);
    vec3 diff   = albedo * (1.0 - metallic);
    vec3 spec   = env_brdf_approx2(F0, roughness * roughness, dot(N, V));

    imageStore(o_albedo, px, vec4(diff, 0.0));
    imageStore(o_spec_albedo, px, vec4(clamp(spec, vec3(0.0), vec3(1.0)), 0.0));
    imageStore(o_normal_rough, px, vec4(N, roughness));
}
